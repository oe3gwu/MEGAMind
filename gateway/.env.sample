# Copy to .env and fill in real values:
#   cp .env.sample .env
#
# LITELLM_MASTER_KEY = token MEGAMind sends as Authorization: Bearer …
# UPSTREAM_API_BASE  = OpenAI-compatible upstream base URL (HTTPS)
# UPSTREAM_API_KEY   = upstream HTTPS API key (never commit the real value)

LITELLM_MASTER_KEY=retrosystem
UPSTREAM_API_BASE=https://api.example.com/v1
UPSTREAM_API_KEY=sk-your-upstream-api-key-here
